# Rust specific
/target/
**/*.rs.bk
Cargo.lock

# IDE specific
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Build artifacts
*.o
*.so
*.dylib
*.dll
*.exe

# Large test files and binaries (prevent accidental commits)
*.bin
*.dat
*100mb*
*1gb*
test_large*
test_performance*
librorum_backend
# But allow small essential binaries if needed
!small_*.bin

# Debug files
*.pdb

# Environment files
.env
.env.local
.env.*.local

# Log files
*.log
daemon*.log

# Test and temporary files
test_*.txt
test_*.bin
test_*.dat
test_*.sh
temp_*/
temp_icon/

# System files
.DS_Store
Thumbs.db 

logs/
buildServer.json
build/

# Swift/Xcode specific
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
*.moved-aside
DerivedData/
*.hmap
*.ipa

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Backend binaries (auto-generated by build process)
client/librorum/Resources/librorum*
client/librorum/Resources/librorum_backend*

# VDFS runtime directories (cache and databases)
core/vdfs_disk_cache/
core/vdfs_cache/
core/sled_db/